{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEX package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "architecture",
    "category",
    "installerType",
    "entryPoint",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "architecture": {
      "enum": [
        "Any",
        "X86",
        "X64",
        "Arm64"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "installerType": {
      "enum": [
        "Exe",
        "Msi"
      ]
    },
    "installationMode": {
      "enum": [
        "Manual",
        "VerifiedUnattended"
      ],
      "default": "Manual"
    },
    "verifiedProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requiresAdministrator": {
      "type": "boolean",
      "default": false
    },
    "entryPoint": {
      "type": "string",
      "pattern": "^packages[/\\\\][^/\\\\]+[/\\\\].+"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "installationMode"
        ],
        "properties": {
          "installationMode": {
            "const": "VerifiedUnattended"
          }
        }
      },
      "then": {
        "required": [
          "verifiedProfileId"
        ],
        "properties": {
          "verifiedProfileId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
