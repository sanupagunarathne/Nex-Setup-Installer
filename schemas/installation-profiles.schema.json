{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technician-verified NEX installation profiles",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "packageId",
      "version",
      "architecture",
      "installerType",
      "entrySha256",
      "arguments",
      "noRestartVerified",
      "verificationNote",
      "verifiedAtUtc"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "packageId": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "architecture": {
        "enum": [
          "Any",
          "X86",
          "X64",
          "Arm64"
        ]
      },
      "installerType": {
        "enum": [
          "Exe",
          "Msi"
        ]
      },
      "entrySha256": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      },
      "arguments": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "noRestartVerified": {
        "const": true
      },
      "verificationNote": {
        "type": "string",
        "minLength": 1
      },
      "verifiedAtUtc": {
        "type": "string",
        "format": "date-time"
      },
      "successExitCodes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0,
          "not": {
            "const": 1641
          }
        }
      },
      "restartExitCodes": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "not": {
            "const": 1641
          }
        }
      }
    }
  },
  "description": "Runtime requires matching package/version/architecture/type/hash, verification evidence, no restart attestation, unique IDs, valid code lists, and MSI public-property-only arguments. Store externally beside the application, not in Git."
}
