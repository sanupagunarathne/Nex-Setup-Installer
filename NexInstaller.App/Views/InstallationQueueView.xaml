<UserControl x:Class="NexInstaller.App.Views.InstallationQueueView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
  <TextBlock Text="Your install list" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="{Binding Count, StringFormat='{}{0} items · installed one at a time'}" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
  <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/></StackPanel>
    <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}"/>
   </Grid>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <StackPanel IsEnabled="{Binding IsIdle}">
   <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><CheckBox IsChecked="{Binding ContinueOnFailure}" AutomationProperties.Name="Continue after failures"/><TextBlock Text="Continue after a failed item (default: stop)" Margin="10,0,0,0"/></StackPanel>
   <WrapPanel><Button Content="Review &amp; install" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button Content="Clear list" Command="{Binding ClearCommand}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel>
  <Button Content="Stop after current installation" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" HorizontalAlignment="Left" Margin="0,8,0,12"/>
  <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}"/>
  <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,12,0,12"/>
  <ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate>
   <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding ExitCode, StringFormat='Exit code: {0}'}" Style="{StaticResource Caption}"/></StackPanel>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></Border>
</UserControl>
