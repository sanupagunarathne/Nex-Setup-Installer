<UserControl x:Class="NexInstaller.App.Views.FontLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexInstaller.App.Views">
 <StackPanel>
  <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><StackPanel>
   <WrapPanel>
    <Button Content="Add font files" Command="{Binding BrowseFilesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
    <Button Content="Import source folder" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,8"/>
    <Button Content="Delete selected font" Command="{Binding DeleteSelectedCommand}" Margin="0,0,0,8"/>
   </WrapPanel>
   <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
   <views:FolderToolsView DataContext="{Binding FolderTools}"/>
   <DockPanel Margin="0,4,0,8">
    <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding FolderFilters}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Label" AutomationProperties.Name="Font folder filter"/>
    <TextBlock Text="{Binding SelectedFolder.Label}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
   </DockPanel>
   <ListBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" Height="190" SelectionChanged="PreviewChanged" AutomationProperties.Name="Font library">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <WrapPanel Margin="0,12,0,0">
    <Button Content="Add selected to install list" Command="{Binding QueueSelectedCommand}" Margin="0,0,8,8"/>
    <Button Content="Add all shown to install list" Command="{Binding QueueFolderCommand}" Margin="0,0,0,8"/>
   </WrapPanel>
   <StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding LicenseConfirmed}" AutomationProperties.Name="Confirm font licenses"/><TextBlock Text="I confirm the font licenses permit use on destination devices." Margin="10,0,0,0" Style="{StaticResource Caption}"/></StackPanel>
   <Expander Header="Font preview and file details" Margin="0,12,0,0"><StackPanel>
    <TextBlock x:Name="PreviewText" Text="Aa Bb Cc ? 0123456789" FontSize="28" Margin="0,8,0,8"/>
    <TextBlock x:Name="PreviewNotice" Text="Select a font to preview it." Style="{StaticResource Caption}"/>
    <TextBlock Text="{Binding SelectedFont.Path}" Style="{StaticResource Caption}"/>
    <TextBlock Text="{Binding SelectedFont.Sha256}" Style="{StaticResource Caption}"/>
   </StackPanel></Expander>
   <Expander Header="Import destination and progress" Margin="0,8,0,0"><StackPanel>
    <TextBlock Text="Save new fonts in folder (blank for Unfiled)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Folders}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="Font library folder"/>
    <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <Button Content="Cancel import" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel></Expander>
  </StackPanel></Border>
  <Expander Header="Install list"><views:InstallationQueueView DataContext="{Binding InstallationQueue}"/></Expander>
 </StackPanel>
</UserControl>
