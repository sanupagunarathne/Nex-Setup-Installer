<UserControl x:Class="NexInstaller.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="0.95*"/><RowDefinition Height="Auto"/><RowDefinition Height="0.7*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="720" Margin="16,0">
   <TextBlock Text="Your software, ready to go." FontSize="32" FontWeight="SemiBold" TextAlignment="Center"/>
   <TextBlock Text="Keep your installers and fonts together on one USB drive.&#10;Choose what each laptop needs, then follow the installation steps." Style="{StaticResource SecondaryText}" FontSize="15" TextAlignment="Center" Margin="0,20,0,0"/>
  </StackPanel>
  <UniformGrid Grid.Row="3" Columns="3" Margin="0,24,0,16">
   <Button Command="{Binding Shell.OpenAppsCommand}" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceBrush}" Padding="16" Margin="0,0,8,0" ToolTip="Open Apps">
    <StackPanel><TextBlock Text="Apps"/><TextBlock Text="{Binding Shell.AvailablePackageCount}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
   </Button>
   <Button Command="{Binding Shell.OpenFontsCommand}" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceBrush}" Padding="16" Margin="4,0,4,0" ToolTip="Open Fonts">
    <StackPanel><TextBlock Text="Fonts"/><TextBlock Text="{Binding Shell.FontCount}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
   </Button>
   <Button Command="{Binding Shell.OpenPresetsCommand}" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceBrush}" Padding="16" Margin="8,0,0,0" ToolTip="Open Saved setups">
    <StackPanel><TextBlock Text="Saved setups"/><TextBlock Text="{Binding Shell.PresetCount}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
   </Button>
  </UniformGrid>
  <StackPanel Grid.Row="4" Margin="0,0,0,8">
   <TextBlock Text="Counts reflect your saved library. Files are checked again before installation." Style="{StaticResource Caption}" TextAlignment="Center"/>
   <Expander Header="Library status" Margin="0,12,0,0" Foreground="{StaticResource SecondaryBrush}" FontSize="11">
    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{Binding Shell.LibraryStatus}" Style="{StaticResource Caption}"/>
     <TextBlock Text="{Binding Shell.LastRefreshed, StringFormat='Last checked: {0}'}" Style="{StaticResource Caption}"/>
     <TextBlock Text="{Binding Shell.SessionCount, StringFormat='Recent installation records (30 days): {0}'}" Style="{StaticResource Caption}"/>
     <TextBlock Text="{Binding Shell.LibraryRoot}" Style="{StaticResource Caption}"/>
    </StackPanel></ScrollViewer>
   </Expander>
  </StackPanel>
 </Grid>
</UserControl>
