<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NexInstaller.App.Views.CompactInstallListView">
  <Border Style="{StaticResource Card}" Padding="20">
    <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MinHeight="{Binding ViewportHeight, ElementName=QueueScroll, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Your install list" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding Count, StringFormat='{}{0} items'}" Style="{StaticResource Caption}" Margin="0,8,0,16" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,12" />
            <TextBlock Text="Add your choices to this list when you are ready." TextAlignment="Center" Style="{StaticResource Caption}" />
          </StackPanel>
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,8" />
                        <Button Content="Remove" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" Padding="10,5" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander Header="Results" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding Results}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,8,0,12">
                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ExitCode, StringFormat='Exit code: {0}'}" Style="{StaticResource Caption}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2">
          <Expander Header="More options" Margin="0,0,0,12" Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel IsEnabled="{Binding IsIdle}">
              <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding ContinueOnFailure}" AutomationProperties.Name="Continue after a failed installation" />
                <TextBlock Text="Continue after a failed item" Margin="10,0,0,0" />
              </StackPanel>
              <TextBlock Text="Normally the list stops when an item fails." Style="{StaticResource Caption}" Margin="0,8,0,12" />
              <Button Content="Clear list" Command="{Binding ClearCommand}" />
            </StackPanel>
          </Expander>
          <Button Content="Review installation" Command="{Binding StartCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasItems}" Value="True" />
                      <Condition Binding="{Binding IsIdle}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Stop after current item" Command="{Binding StopCommand}" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" MaxHeight="66" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,10,0,0" Visibility="{Binding HasStarted, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <ProgressBar Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Height="4" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" Margin="0,12,0,0" />
          <Expander Header="Progress and messages" Margin="0,12,0,0" Visibility="{Binding HasStarted, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
          </Expander>
          <TextBlock Text="You will confirm before anything starts." Style="{StaticResource Caption}" Margin="0,12,0,0" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Border>
</UserControl>
