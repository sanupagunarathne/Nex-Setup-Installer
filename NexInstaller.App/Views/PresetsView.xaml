<UserControl x:Class="NexInstaller.App.Views.PresetsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexInstaller.App.Views">
 <StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel IsEnabled="{Binding IsIdle}">
   <TextBlock Text="Saved installation presets" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Select a preset to load its software IDs and relative font references." Style="{StaticResource Caption}" Margin="0,8,0,12"/>
   <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Height="160" AutomationProperties.Name="Saved presets"/>
   <Button Content="New preset" Command="{Binding NewCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel IsEnabled="{Binding IsIdle}">
   <TextBlock Text="Preset editor" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Name (edit to rename the preset)" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
   <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Preset name"/>
   <TextBlock Text="{Binding EditNotice}" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
   <WrapPanel><Button Content="Add selected software" Command="{Binding AddSoftwareCommand}" Margin="0,0,12,8"/><Button Content="Add inspected font" Command="{Binding AddFontCommand}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="Select software checkboxes in Software Library, or inspect a font row in Font Library, then return here to add them. Remove entries below to edit the preset." Style="{StaticResource SecondaryText}" Margin="0,8,0,16"/>
   <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}"/>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="Save preset JSON" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,16"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><CheckBox IsChecked="{Binding FontLicenseConfirmed}" AutomationProperties.Name="Preset font license acknowledgement"/><TextBlock Text="I confirm licenses permit installing this preset's fonts on the destination device." Margin="10,0,0,0"/></StackPanel>
   <Button Content="Start saved preset" Command="{Binding StartCommand}" HorizontalAlignment="Left"/>
   <TextBlock Text="All references must resolve. A pending queue can only be replaced after confirmation. Each installation still requires fresh preflight and technician confirmation." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/></StackPanel></Border>
  <views:InstallationQueueView DataContext="{Binding Queue}"/>
 </StackPanel>
</UserControl>
