<UserControl x:Class="NexInstaller.App.Views.SoftwareLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexInstaller.App.Views" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid MinHeight="540">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12" MaxHeight="44">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
   <Grid><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search apps…" Padding="38,11,12,11" AutomationProperties.Name="Search apps"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{StaticResource SecondaryBrush}"/></Grid>
   <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" AutomationProperties.Name="Group filter"/>
   <ComboBox Grid.Column="4" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Label" AutomationProperties.Name="App folder filter"/>
  </Grid>
  <Grid Grid.Row="1" MinHeight="380">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14">
      <DockPanel><Button DockPanel.Dock="Right" Content="Delete selected" Command="{Binding DeleteSelectedCommand}" Padding="10,7" Margin="8,0,0,0" ToolTip="Delete checked apps, or the highlighted app if none are checked, from the saved library."/><TextBlock Text="{Binding Results}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="{Binding SelectedFolder.Label}" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding ManagementStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
      <views:FolderToolsView DataContext="{Binding FolderTools}"/>
     </StackPanel>
     <Grid Grid.Row="1" Margin="10,0,10,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="App name" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Version" Style="{StaticResource Caption}"/><TextBlock Grid.Column="3" Text="Group" Style="{StaticResource Caption}"/>
     </Grid>
     <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Available apps">
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Margin="10,12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}"/>
         <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Availability}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Version}"/>
         <TextBlock Grid.Column="3" Text="{Binding Category}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Category}"/>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350" Margin="20" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
       <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionTitle}" TextAlignment="Center"/><TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,8"/>
       <Button Content="{Binding EmptyActionLabel}" Command="{Binding OpenAddFilesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
     <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEmpty}" Value="True"/><Condition Binding="{Binding SelectedCount}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
      <WrapPanel><Button Content="Select available" Command="{Binding SelectVisibleCommand}" Padding="10,7" Margin="0,0,8,8"/><Button Content="Clear choices" Command="{Binding ClearSelectionCommand}" Padding="10,7" Margin="0,0,0,8"/></WrapPanel>
      <Button Content="Add selected apps to install list →" Command="{Binding AddToQueueCommand}" Style="{StaticResource PrimaryButton}"/>
      <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected · selections stay while filtering'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <views:CompactInstallListView Grid.Column="2" DataContext="{Binding InstallationQueue}"/>
  </Grid>
  <Expander Grid.Row="2" Header="App details, file checks and more filters" Margin="0,14,0,0">
   <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Computer type filter" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" AutomationProperties.Name="Computer type filter"/>
    <TextBlock Text="{Binding Issues}" Style="{StaticResource Caption}" Margin="0,10,0,8"/>
    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="App details and availability reasons"/>
   </StackPanel></ScrollViewer>
  </Expander>
 </Grid>
</UserControl>
