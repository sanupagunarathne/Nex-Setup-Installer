<UserControl x:Class="NexInstaller.App.Views.SoftwareLibraryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexInstaller.App.Views">
 <StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <StackPanel>
    <TextBlock Text="Search by name, version, ID, or description" Style="{StaticResource Caption}" Margin="0,0,0,8" />
    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search software" />
    <Grid Margin="0,12,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" AutomationProperties.Name="Category filter" />
     <ComboBox Grid.Column="2" ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" AutomationProperties.Name="Architecture filter" />
    </Grid>
   </StackPanel>
  </Border>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16">
    <StackPanel>
     <TextBlock Text="{Binding Results}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
     <WrapPanel Margin="0,0,0,12">
      <Button Content="Select available" Command="{Binding SelectVisibleCommand}" Margin="0,0,8,8" />
      <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,0,8" />
     </WrapPanel>
     <TextBlock Text="No packages match. Add manifests and installer files to the configured library, then refresh." Style="{StaticResource SecondaryText}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16" />
     <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" Height="350" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Discovered software">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid Margin="8,10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}" />
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding Architecture}"/><Run Text=" · "/><Run Text="{Binding Category}"/></TextBlock>
          <TextBlock Text="{Binding Availability}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,6,0,0" />
         </StackPanel>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
    <StackPanel>
     <TextBlock Text="Selected software" Style="{StaticResource SectionTitle}" />
     <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,12" />
     <ItemsControl ItemsSource="{Binding SelectedPackages}">
      <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="Selections stay selected while filtering. Add them to the queue, then start it below for preflight and confirmation." Style="{StaticResource SecondaryText}" Margin="0,12,0,20" />
     <Button Content="Add selected to queue" Command="{Binding AddToQueueCommand}" />
     <TextBlock Text="Every item requires technician confirmation" Style="{StaticResource Caption}" Margin="0,12,0,0" />
    </StackPanel>
   </Border>
  </Grid>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <StackPanel>
    <TextBlock Text="Package details" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Package details" />
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Card}">
   <StackPanel><TextBlock Text="Discovery diagnostics" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><TextBlock Text="{Binding Issues}" Style="{StaticResource SecondaryText}" /></StackPanel>
  </Border>
 <views:InstallationQueueView DataContext="{Binding InstallationQueue}"/>
 </StackPanel>
</UserControl>
