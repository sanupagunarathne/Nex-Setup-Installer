<UserControl x:Class="NexInstaller.App.Views.HistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,20">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Local installation sessions" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Export report" IsEnabled="False" />
    </Grid>
  </Border>
  <Border Style="{StaticResource Card}" MinHeight="340">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
      <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="Every installation, accounted for" Style="{StaticResource SectionTitle}" TextAlignment="Center" Margin="0,20,0,12" />
      <TextBlock Text="Session timestamps, package results, exit codes, failures, restart requirements, and exportable reports are planned for Phase 5." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
      <TextBlock Text="No customer identity information is needed." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,20,0,0" />
    </StackPanel>
  </Border>
</StackPanel>
</UserControl>
