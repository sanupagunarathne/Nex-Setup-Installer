<Window x:Class="NexInstaller.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEX Installer" Width="1280" Height="840" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,28,16,16">
    <StackPanel DockPanel.Dock="Top" Margin="14,0,0,34"><TextBlock Text="NEX" FontSize="32" FontWeight="Bold"/><TextBlock Text="INSTALLER" Style="{StaticResource Eyebrow}" Margin="2,4,0,0"/></StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Portable · v0.5.2" Style="{StaticResource Caption}" Margin="14,16,0,0"/>
    <ItemsControl ItemsSource="{Binding NavigationItems}"><ItemsControl.ItemTemplate><DataTemplate>
     <Button Command="{Binding SelectCommand}" Style="{StaticResource NavigationButton}" AutomationProperties.Name="{Binding Title}">
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}"/></StackPanel>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,24,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource SecondaryText}" Margin="0,8,16,0"/></StackPanel>
    <Button Grid.Column="1" Content="Refresh files" Command="{Binding RefreshCommand}" VerticalAlignment="Top" ToolTip="Read your saved files and installation records again."/>
   </Grid>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0,0,6,0">
    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger><DataTrigger Binding="{Binding IsAppsWorkbench}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
    <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource BackgroundBrush}">
   <StackPanel>
    <ProgressBar IsIndeterminate="True" Height="2" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <Grid Margin="24,10,24,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Offline workspace" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="{Binding LibraryRoot}"/><Button Content="↻" Command="{Binding RefreshCommand}" Margin="12,0,0,0" Padding="8,4" ToolTip="Refresh saved files" AutomationProperties.Name="Refresh saved files"/></StackPanel>
     <StackPanel Grid.Column="1" HorizontalAlignment="Right">
      <TextBlock Text="Sanupa Gunarathne" FontSize="10" HorizontalAlignment="Right"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
       <Button Click="OpenSocialLink" Tag="github" ToolTip="GitHub — Sanupa Gunarathne" AutomationProperties.Name="Open Sanupa's GitHub profile" Padding="5" Background="Transparent" BorderThickness="0"><Image Source="{StaticResource GithubIcon}" Width="15" Height="15"/></Button>
       <Button Click="OpenSocialLink" Tag="linkedin" ToolTip="LinkedIn — Sanupa Gunarathne" AutomationProperties.Name="Open Sanupa's LinkedIn profile" Padding="5" Background="Transparent" BorderThickness="0" Margin="6,0,0,0"><Image Source="{StaticResource LinkedinIcon}" Width="15" Height="15"/></Button>
       <Button Click="OpenSocialLink" Tag="instagram" ToolTip="Instagram — Sanupa Gunarathne" AutomationProperties.Name="Open Sanupa's Instagram profile" Padding="5" Background="Transparent" BorderThickness="0" Margin="6,0,0,0"><Image Source="{StaticResource InstagramIcon}" Width="15" Height="15"/></Button>
      </StackPanel>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
